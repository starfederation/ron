{
  "name": "RON",
  "scopeName": "source.ron",
  "patterns": [
    {
      "include": "#punctuation-tokens"
    },
    {
      "include": "#escapes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#invalid-controls"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#vars"
    },
    {
      "include": "#tempids"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "punctuation-tokens": {
      "patterns": [
        {
          "name": "string.unquoted.punctuation.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])(?:'(?![^\\[\\]{}\\n]*')|,(?:\\\\(?:[\"\\\\/bfnrt]|u(?:[dD][89aAbB][0-9A-Fa-f]{2}\\\\u[dD][c-fC-F][0-9A-Fa-f]{2}|(?![dD][89a-fA-F])[0-9A-Fa-f]{4}))|[^\\s\\[\\]{}'\",\\\\\\x00-\\x1F])*)"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.ron",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u(?:[dD][89aAbB][0-9A-Fa-f]{2}\\\\u[dD][c-fC-F][0-9A-Fa-f]{2}|(?![dD][89a-fA-F])[0-9A-Fa-f]{4}))"
        },
        {
          "name": "invalid.illegal.escape.ron",
          "match": "\\\\(?:u[0-9A-Fa-f]{4}|u[0-9A-Fa-f]{0,3}(?![0-9A-Fa-f])|.)?"
        }
      ]
    },
    "invalid-controls": {
      "patterns": [
        {
          "name": "invalid.illegal.control.ron",
          "match": "[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]"
        }
      ]
    },
    "invalid-string-content": {
      "patterns": [
        {
          "name": "invalid.illegal.character.ron",
          "match": "[\"\\x00-\\x1F]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ron",
          "begin": "(?<!\\\\)(\"{1,})(?!\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.ron"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ron"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#invalid-string-content"
            }
          ]
        },
        {
          "name": "string.quoted.single.ron",
          "begin": "(?<!\\\\)('{1,})(?!')",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.ron"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ron"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#invalid-string-content"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])(?:true|false)(?![^\\s\\[\\]{}'\",])"
        },
        {
          "name": "constant.language.null.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])null(?![^\\s\\[\\]{}'\",])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?![^\\s\\[\\]{}'\",])"
        }
      ]
    },
    "vars": {
      "patterns": [
        {
          "name": "variable.other.query.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])\\?[A-Za-z0-9_./!$%&*+=<>:-]+(?![^\\s\\[\\]{}'\",])"
        }
      ]
    },
    "tempids": {
      "patterns": [
        {
          "name": "entity.name.label.tempid.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])#_[A-Za-z0-9_./!$%&*+=<>:-]+(?![^\\s\\[\\]{}'\",])"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])#[A-Za-z0-9_./!$%&*+=<>:-]*(?![^\\s\\[\\]{}'\",])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.section.braces.begin.ron",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.ron",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.ron",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.ron",
          "match": "\\]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "string.unquoted.ron",
          "match": "(?<![^\\s\\[\\]{}'\",])(?:\\\\(?:[\"\\\\/bfnrt]|u(?:[dD][89aAbB][0-9A-Fa-f]{2}\\\\u[dD][c-fC-F][0-9A-Fa-f]{2}|(?![dD][89a-fA-F])[0-9A-Fa-f]{4}))|[^\\s\\[\\]{}'\",\\\\\\x00-\\x1F])+(?![^\\s\\[\\]{}'\",])"
        }
      ]
    }
  },
  "uuid": "bb6bb388-6c27-4ca2-8c68-0c8fc2903090"
}
