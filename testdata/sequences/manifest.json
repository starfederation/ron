{
  "version": 1,
  "formats": {
    "ndron": {
      "name": "Newline-delimited RON",
      "mediaType": "application/x-ndron",
      "fileExtension": ".ndron",
      "encoding": "UTF-8",
      "encoderRecord": "RON-text LF",
      "parserLineEndings": [
        "LF",
        "CRLF"
      ],
      "emptyLinePolicy": "configurable",
      "finalLineTerminatorRequired": true
    },
    "ronTextSequence": {
      "name": "RON text sequence",
      "mediaType": "application/ron-seq",
      "encoding": "UTF-8 with binary framing",
      "encoderRecord": "RS RON-text LF",
      "recordSeparatorHex": "1e",
      "lineFeedHex": "0a",
      "continueAfterElementError": true,
      "consecutiveRecordSeparatorsAreEmptyElements": false
    }
  },
  "validNDRON": [
    {
      "name": "empty",
      "inputValuesJSON": "valid/empty/input.values.json",
      "ronInputs": [
        "valid/empty/expected.ndron"
      ],
      "expectedNDRON": "valid/empty/expected.ndron",
      "options": {
        "mode": "compact"
      }
    },
    {
      "name": "mixed",
      "inputValuesJSON": "valid/mixed/input.values.json",
      "ronInputs": [
        "valid/mixed/expected.ndron",
        "valid/mixed/input.crlf.ndron"
      ],
      "expectedNDRON": "valid/mixed/expected.ndron",
      "options": {
        "mode": "compact"
      }
    }
  ],
  "invalidNDRON": [
    "invalid/ndron/escape_unknown.ndron",
    "invalid/ndron/missing_final_lf.ndron",
    "invalid/ndron/raw_cr.ndron",
    "invalid/ndron/raw_multiline_string.ndron"
  ],
  "validRONSequences": [
    {
      "name": "empty",
      "inputValuesJSON": "valid/empty/input.values.json",
      "ronInputs": [
        "valid/empty/expected.ronseq"
      ],
      "expectedRONSequence": "valid/empty/expected.ronseq",
      "options": {
        "mode": "compact"
      }
    },
    {
      "name": "mixed_compact",
      "inputValuesJSON": "valid/mixed/input.values.json",
      "ronInputs": [
        "valid/mixed/expected.ronseq"
      ],
      "expectedRONSequence": "valid/mixed/expected.ronseq",
      "options": {
        "mode": "compact"
      }
    },
    {
      "name": "pretty",
      "inputValuesJSON": "valid/pretty/input.values.json",
      "ronInputs": [
        "valid/pretty/expected.ronseq"
      ],
      "expectedRONSequence": "valid/pretty/expected.ronseq",
      "options": {
        "mode": "pretty"
      }
    }
  ],
  "recoveryRONSequences": [
    {
      "name": "malformed_element",
      "inputRONSequence": "recovery/malformed/input.ronseq",
      "expectedValuesJSON": "recovery/malformed/expected.values.json",
      "expectedElementErrors": 1
    },
    {
      "name": "invalid_preamble",
      "inputRONSequence": "recovery/preamble/input.ronseq",
      "expectedValuesJSON": "recovery/preamble/expected.values.json",
      "expectedElementErrors": 1
    },
    {
      "name": "truncated_bare_elements",
      "inputRONSequence": "recovery/truncated/input.ronseq",
      "expectedValuesJSON": "recovery/truncated/expected.values.json",
      "expectedElementErrors": 2
    },
    {
      "name": "consecutive_record_separators",
      "inputRONSequence": "recovery/consecutive_rs/input.ronseq",
      "expectedValuesJSON": "recovery/consecutive_rs/expected.values.json",
      "expectedElementErrors": 0
    },
    {
      "name": "self_delimited_without_lf",
      "inputRONSequence": "recovery/self_delimited/input.ronseq",
      "expectedValuesJSON": "recovery/self_delimited/expected.values.json",
      "expectedElementErrors": 0
    }
  ]
}
